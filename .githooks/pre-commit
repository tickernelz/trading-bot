#!/bin/sh
shebang='^\+#!'
pragma='^\+\s*(//|#|/\*)\s*(@ts-|eslint|noqa|type:|pragma|yaml-language-server|ruff|pyright|biome)'
other='^\+\s*(//|#|/\*|\*)'
python='^\+\s*#'
hits=$(git diff --cached -U0 --diff-filter=ACM -- '*.ts' '*.tsx' '*.js' '*.yaml' '*.yml' | grep -E "$other" | grep -v -E "$shebang" | grep -v -E "$pragma" || true)
pyhits=$(git diff --cached -U0 --diff-filter=ACM -- '*.py' | grep -E "$python" | grep -v -E "$shebang" | grep -v -E "$pragma" || true)
hits=$(printf '%s\n%s' "$hits" "$pyhits" | sed '/^$/d')
if [ -n "$hits" ]; then
  echo "pre-commit: comment gate failed:"
  echo "$hits"
  exit 1
fi
