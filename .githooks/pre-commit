#!/bin/sh
whitelist='^\+\s*(//|#|/\*)\s*(@ts-|eslint|noqa|type:|pragma|yaml-language-server|ruff|pyright|biome)'
py_hits=$(git diff --cached -U0 --diff-filter=ACM -- '*.py' | grep -E '^\+\s*#' | grep -v -E '^\+#!' | grep -v -E "$whitelist" || true)
web_hits=$(git diff --cached -U0 --diff-filter=ACM -- '*.ts' '*.tsx' '*.js' '*.vue' '*.scss' '*.css' '*.yaml' '*.yml' | grep -E '^\+\s*(//|#|/\*|\*)' | grep -v -E '^\+#!' | grep -v -E "$whitelist" || true)
if [ -n "$py_hits$web_hits" ]; then
  echo "pre-commit: comment gate failed:"
  [ -n "$py_hits" ] && echo "$py_hits"
  [ -n "$web_hits" ] && echo "$web_hits"
  exit 1
fi
